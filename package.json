{
  "name": "cesiumjs-vite-example",
  "version": "1.0.0",
  "description": "The minimal recommended setup for an app using Cesium with Vite.",
  "homepage": "https://cesium.com/platform/cesiumjs/",
  "license": "Apache-2.0",
  "author": {
    "name": "Cesium GS, Inc.",
    "url": "https://cesium.com"
  },
  "keywords": [
    "cesium",
    "CesiumJS",
    "vite",
    "example"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CesiumGS/cesium-vite-example.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint \"./**/*.{ts,js}\" --cache --quiet",
    "prettier": "prettier --write --no-config \"**/*\"",
    "prettier-check": "prettier --check --no-config \"**/*\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-cesium": "^11.0.1",
    "eslint-plugin-es": "^4.1.0",
    "eslint-plugin-html": "^8.1.4",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-static-copy": "^4.0.0"
  },
  "dependencies": {
    "@cesium-extends/compass": "^1.2.2",
    "@cesium-extends/zoom-control": "^1.2.2",
    "cesium": "^1.139.1",
    "colormap": "^2.3.2",
    "geographiclib": "^1.52.2"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --cache --quiet",
      "prettier --write --no-config"
    ],
    "*.html": [
      "prettier --write --no-config"
    ]
  }
}
